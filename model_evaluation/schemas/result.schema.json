{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "model",
    "benchmark",
    "framework",
    "metrics",
    "raw_result"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "common.schema.json#/$defs/id"},
    "model": {"$ref": "common.schema.json#/$defs/id"},
    "benchmark": {"$ref": "common.schema.json#/$defs/id"},
    "framework": {"$ref": "common.schema.json#/$defs/id"},
    "metrics": {"$ref": "canonical_result.schema.json#/$defs/metricMap"},
    "raw_result": {"$ref": "#/$defs/rawArtifact"},
    "metadata": {"type": "object", "additionalProperties": true},
    "breakdowns": {"$ref": "canonical_result.schema.json#/$defs/breakdowns"},
    "sample_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/sampleArtifact"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "rawArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type"],
      "properties": {
        "path": {"allOf": [{"$ref": "#/$defs/relativePath"}, {"pattern": "^raw/"}]},
        "media_type": {"type": "string", "minLength": 1}
      }
    },
    "sampleArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type"],
      "properties": {
        "path": {"allOf": [{"$ref": "#/$defs/relativePath"}, {"pattern": "^samples/"}]},
        "media_type": {"type": "string", "minLength": 1}
      }
    }
  }
}
