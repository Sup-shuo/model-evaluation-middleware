{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "env_patch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "set": {
      "$ref": "common.schema.json#/$defs/stringMap"
    },
    "unset": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "prepend_path": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "append_path": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "default": {}
}
