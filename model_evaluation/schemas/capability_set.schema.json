{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability_set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "values"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/jsonValue"
      }
    }
  }
}
