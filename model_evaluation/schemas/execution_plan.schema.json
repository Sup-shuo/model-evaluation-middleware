{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution_plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "run_spec",
    "adapters",
    "compatibility",
    "resources",
    "stages",
    "resolved"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "run_spec": {
      "$ref": "run_spec.schema.json"
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "version"
        ],
        "properties": {
          "kind": {
            "enum": [
              "device",
              "runtime",
              "environment",
              "backend",
              "dataset",
              "binding",
              "evaluator"
            ]
          },
          "name": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/semver"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "compatible",
            "incompatible",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {"$ref": "capability_diagnostic.schema.json"}
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "resource_claim.schema.json"
      }
    },
    "stages": {
      "type": "array",
      "prefixItems": [
        {"const": "PLATFORM_READY"},
        {"const": "DATA_READY"},
        {"const": "TASK_READY"},
        {"const": "EVALUATOR_PREFLIGHT"},
        {"const": "SERVICE_STARTING"},
        {"const": "SERVICE_READY"},
        {"const": "EVALUATING"},
        {"const": "NORMALIZING"},
        {"const": "CLEANING"}
      ],
      "items": false,
      "minItems": 9,
      "maxItems": 9
    },
    "resolved": {
      "$ref": "resolved_execution.schema.json"
    },
    "protocol_fingerprints": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "adapter",
          "operation",
          "message"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "adapter": {
            "type": "string"
          },
          "operation": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
