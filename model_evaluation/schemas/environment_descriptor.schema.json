{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment_descriptor.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "identity"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "string",
      "minLength": 1
    },
    "python": {
      "type": "string"
    },
    "executable_root": {
      "type": "string"
    },
    "capabilities": {
      "$ref": "capability_set.schema.json"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
