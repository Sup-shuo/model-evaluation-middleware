{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "requirement_set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "op"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
          },
          "op": {
            "enum": [
              "equals",
              "in",
              "gte",
              "lte",
              "min_version",
              "exists"
            ]
          },
          "value": {
            "$ref": "common.schema.json#/$defs/jsonValue"
          },
          "optional": {
            "type": "boolean",
            "default": false
          },
          "message": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "const": "exists"
                }
              }
            },
            "then": {},
            "else": {
              "required": [
                "value"
              ]
            }
          }
        ]
      }
    }
  }
}
