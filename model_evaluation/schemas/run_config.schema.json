{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "plan_id",
    "started_at",
    "timezone",
    "adapters",
    "selection",
    "model",
    "benchmark",
    "backend",
    "evaluator",
    "system",
    "resolved_runtime"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "common.schema.json#/$defs/id"},
    "plan_id": {"type": "string", "pattern": "^plan-[a-f0-9]{24}$"},
    "started_at": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string", "minLength": 1},
    "adapters": {"$ref": "execution_plan.schema.json#/properties/adapters"},
    "selection": {"$ref": "run_spec.schema.json"},
    "model": {"$ref": "model_spec.schema.json"},
    "benchmark": {"$ref": "benchmark_spec.schema.json"},
    "backend": {"$ref": "deployment_profile.schema.json"},
    "evaluator": {"$ref": "evaluation_profile.schema.json"},
    "system": {"$ref": "platform_profile.schema.json"},
    "resolved_runtime": {"$ref": "resolved_platform.schema.json"}
  }
}
