{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matrix_batch_runs.schema.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "index", "plan_id", "model_id", "model_label", "model_ref",
      "benchmark", "platform", "deployment", "evaluation", "status", "attempts"
    ],
    "properties": {
      "index": {"type": "integer", "minimum": 1},
      "plan_id": {"type": "string", "pattern": "^plan-[a-f0-9]{24}$"},
      "model_id": {"type": "string", "minLength": 1},
      "model_label": {"type": "string", "minLength": 1},
      "model_ref": {"type": "string"},
      "benchmark": {"type": "string", "minLength": 1},
      "platform": {"type": "string", "minLength": 1},
      "deployment": {"type": "string", "minLength": 1},
      "evaluation": {"type": "string", "minLength": 1},
      "status": {"enum": ["success", "failed", "interrupted", "not_run"]},
      "attempts": {"type": "integer", "minimum": 0},
      "started_at": {"type": "string", "format": "date-time"},
      "finished_at": {"type": "string", "format": "date-time"},
      "run_dir": {"type": "string", "minLength": 1},
      "result_path": {"type": "string", "minLength": 1},
      "warnings_count": {"type": "integer", "minimum": 0},
      "cleanup_status": {"enum": ["clean", "incomplete"]},
      "error": {"type": "object", "additionalProperties": true}
    },
    "allOf": [
      {
        "if": {"properties": {"status": {"const": "success"}}},
        "then": {"required": ["run_dir", "result_path"]}
      },
      {
        "if": {"properties": {"status": {"const": "not_run"}}},
        "then": {"properties": {"attempts": {"const": 0}}}
      }
    ]
  }
}
