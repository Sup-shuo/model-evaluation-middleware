{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matrix_execution_export.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "export_id", "source_matrix_id", "strategy",
    "plan_count", "shard_count", "shards"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "export_id": {"type": "string", "pattern": "^matrix-export-[a-f0-9]{24}$"},
    "source_matrix_id": {"type": "string", "pattern": "^matrix-[a-f0-9]{24}$"},
    "strategy": {"const": "round_robin"},
    "plan_count": {"type": "integer", "minimum": 1},
    "shard_count": {"type": "integer", "minimum": 1},
    "shards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "path", "plan_count", "plan_ids"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "path": {"type": "string", "pattern": "^shards/shard-[0-9]{4}\\.json$"},
          "plan_count": {"type": "integer", "minimum": 1},
          "plan_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
