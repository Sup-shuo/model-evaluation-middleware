{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "matrix_execution_shard.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "export_id", "source_matrix_id",
    "shard_index", "shard_count", "plans"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "export_id": {"type": "string", "pattern": "^matrix-export-[a-f0-9]{24}$"},
    "source_matrix_id": {"type": "string", "pattern": "^matrix-[a-f0-9]{24}$"},
    "shard_index": {"type": "integer", "minimum": 1},
    "shard_count": {"type": "integer", "minimum": 1},
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "plan_id", "path"],
        "properties": {
          "index": {"type": "integer", "minimum": 1},
          "plan_id": {"type": "string", "minLength": 1},
          "path": {
            "type": "string",
            "pattern": "^plans/[0-9]{6}-[A-Za-z0-9._:+-]+\\.json$"
          }
        }
      }
    }
  }
}
