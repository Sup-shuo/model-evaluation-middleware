{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource_claim.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "exclusive"
  ],
  "properties": {
    "kind": {
      "enum": [
        "device",
        "port",
        "run_lock",
        "cache_lock",
        "workspace",
        "other"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "exclusive": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "host": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "port"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "host"
        ]
      },
      "else": {
        "not": {
          "required": [
            "host"
          ]
        }
      }
    }
  ]
}
