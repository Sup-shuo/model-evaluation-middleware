{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform_profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "evaluation_environment"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "device": {
      "$ref": "#/$defs/deviceSel"
    },
    "runtime": {
      "$ref": "#/$defs/runtimeSel"
    },
    "backend_environment": {
      "$ref": "#/$defs/envSel"
    },
    "evaluation_environment": {
      "$ref": "#/$defs/envSel"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "middleware": {
          "type": "object",
          "additionalProperties": true,
          "not": {
            "required": [
              "adapter_parameters"
            ]
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "device",
        "runtime",
        "backend_environment"
      ]
    },
    {
      "not": {
        "anyOf": [
          {
            "required": [
              "device"
            ]
          },
          {
            "required": [
              "runtime"
            ]
          },
          {
            "required": [
              "backend_environment"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": true
    },
    "deviceSel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    },
    "runtimeSel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter"
      ],
      "properties": {
        "adapter": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "profile": {
          "type": "string"
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    },
    "envSel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "profile"
      ],
      "properties": {
        "provider": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "$ref": "#/$defs/parameters"
        }
      }
    }
  }
}
