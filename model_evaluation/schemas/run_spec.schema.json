{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "platform",
    "deployment",
    "benchmark",
    "evaluation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "model": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "platform": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "deployment": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "benchmark": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "evaluation": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "overrides": {
      "type": "object",
      "additionalProperties": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
