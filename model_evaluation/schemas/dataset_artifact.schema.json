{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dataset_artifact.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "revision",
    "root",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "dataset_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "virtual",
            "concrete"
          ]
        }
      }
    }
  }
}
