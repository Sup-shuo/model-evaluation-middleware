{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lm_eval.user_parameters.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "batch_size": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "num_concurrent": {
      "type": "integer",
      "minimum": 1
    },
    "log_samples": {
      "type": "boolean"
    },
    "limit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      ]
    },
    "tokenized_requests": {
      "type": "boolean"
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0
    },
    "request_timeout": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_length": {
      "type": "integer",
      "minimum": 1
    },
    "tokenizers_parallelism": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "evaluation_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "numpy_random_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "torch_random_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "fewshot_random_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "request_seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "pythonhashseed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "preflight_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "provenance_policy": {
      "enum": [
        "migration",
        "strict"
      ]
    },
    "framework_revision": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{40,64}$"
    },
    "require_clean_framework": {
      "type": "boolean"
    },
    "metric_maps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
