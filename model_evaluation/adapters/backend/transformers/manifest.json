{
  "adapter_api": "1.0",
  "implementation": {
    "language": "python"
  },
  "kind": "backend",
  "name": "transformers",
  "operations": [
    "requirements",
    "plan_preflight",
    "plan_start",
    "probe_service",
    "snapshot"
  ],
  "schema_versions": {
    "backend_start_plan": "1.1",
    "backend_preflight_plan": "1.0",
    "preflight_probe_result": "1.0",
    "process_spec": "1.0",
    "requirement_set": "1.0",
    "service_descriptor": "1.0"
  },
  "user_config": {
    "default_management_mode": "managed",
    "default_parameters": {
      "allow_cpu_offload": false,
      "dependency_probe_timeout_seconds": 45.0,
      "device": "auto",
      "dtype": "auto",
      "max_concurrent": 1,
      "max_request_bytes": 16777216,
      "port": 8091,
      "pythonhashseed": 1234,
      "ready_timeout_seconds": 900,
      "shutdown_timeout_seconds": 15.0,
      "tokenizers_parallelism": false
    },
    "model_location": {
      "modes": [
        "managed"
      ],
      "path_template": "{model.source.ref}",
      "requires_root": true
    },
    "parameters_schema": "user_parameters.schema.json",
    "schema_version": "1.0"
  },
  "version": "1.0.0"
}
